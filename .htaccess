---
layout: null
permalink: /.htaccess
sitemap: false
---
# Generated by Jekyll from .htaccess in the repo; edit it there, not on the server.
# The live host (LiteSpeed) reads this file. GitHub Pages ignores it.

# Copied from the server's previous .htaccess (October 2026) so cPanel can
# still find and manage its block.
# php -- BEGIN cPanel-generated handler, do not edit
# This domain inherits the “PHP” package.
# php -- END cPanel-generated handler, do not edit

ErrorDocument 404 /404.html

RewriteEngine On

# One canonical address: https, no www.
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://computermusic.org.au%{REQUEST_URI} [R=301,L]

# Old URLs, from redirect_from in each page's front matter. These replace the
# HTML redirect pages (which still exist as a fallback) with real 301s.
{% assign items = site.documents | concat: site.html_pages -%}
{% for item in items -%}
{% for from in item.redirect_from -%}
{% assign path = from | remove_first: "/" | split: "/" | join: "/" -%}
RewriteRule ^{{ path | replace: ".", "\." }}/?$ {{ item.url }} [R=301,L]
{% endfor -%}
{% endfor -%}
